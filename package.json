{
  "name": "reverie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A little 3D creature you talk to, with Claude for its thinking and the Game Scroll engine for everything else.",
  "scripts": {
    "setup": "git submodule update --init --depth 1 engine && npm --prefix engine ci && npm ci",
    "dev": "node engine/node_modules/vite/bin/vite.js --host",
    "build": "node engine/node_modules/vite/bin/vite.js build",
    "preview": "node engine/node_modules/vite/bin/vite.js preview --host",
    "smoke": "node tests/smoke.mjs",
    "test:prod": "npm run build && node tests/prod.mjs",
    "test:show": "node tests/show.mjs",
    "test:body": "node tests/body.mjs",
    "test:look": "node tests/lookaround.mjs",
    "test:clean": "node tests/clean.mjs",
    "helpers:sync": "node --env-file-if-exists=.env.local scripts/helpers-sync.mjs",
    "test:sounds": "node tests/sounds.mjs",
    "test:fluid": "node tests/fluid.mjs",
    "latency": "node tests/latency.mjs",
    "test:reminders": "node tests/reminders.mjs && node tests/push.mjs",
    "worker:dev": "npm run build && cd worker && wrangler dev",
    "deploy": "npm run build && cd worker && wrangler deploy"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "wrangler": "^4.168.0"
  }
}
