# Copy this file to .env.local (which git ignores) and put your key there. Never commit a key.
# The key is read by the small backend only (server/turn.js): the dev server, or the Cloudflare Worker,
# where it is a secret instead (npx wrangler secret put ANTHROPIC_API_KEY). The page never sees it.
ANTHROPIC_API_KEY=

# Optional: which models answer. Everyday chat, and the deeper thinker for hard questions.
# REVERIE_QUICK_MODEL=claude-haiku-5-5
# REVERIE_DEEP_MODEL=claude-sonnet-5-5

# Optional: 1 answers with a scripted Claude (no key, no network), for trying the page and for tests.
# REVERIE_FAKE=1

# Where the page sends its turns. Leave empty to use the dev server's own /api/turn.
# Set it to the Worker's address for a built page: VITE_API_URL=https://reverie-api.<you>.workers.dev
VITE_API_URL=

